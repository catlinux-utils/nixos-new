#!/usr/bin/env bash
# nixos-mount — mount prepared disk for nixos-install or maintenance
# Auto-detects layout from partition labels, mounts subvolumes correctly.

set -euo pipefail

# ─── Config ──────────────────────────────────────────────────────────
MNT="/mnt"
DISK=""            # empty = auto-detect (disk with a cryptroot partition)
OPEN_LUKS="yes"    # yes | no (assume already open)
CLOSE_ON_EXIT="no"
UMOUNT="no"        # yes = unmount + close LUKS instead of mounting

# ─── Pretty ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GRN='\033[0;32m'; YEL='\033[1;33m'; BLU='\033[0;34m'; NC='\033[0m'
info() { echo -e "${BLU}[info]${NC} $*"; }
ok()   { echo -e "${GRN}[ok]${NC}  $*"; }
warn() { echo -e "${YEL}[warn]${NC} $*"; }
err()  { echo -e "${RED}[err]${NC}  $*"; }

# ─── Usage ───────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: nixos-mount [options] [disk]

Disk is auto-detected (the one carrying a cryptroot partition);
pass it explicitly only with multiple candidate disks.

Options:
  --mnt PATH        Mount point (default: /mnt)
  --umount          Unmount and close LUKS instead of mounting
  --no-open         Don't open LUKS (assume already open)
  --close-on-exit   Close LUKS on unmount
  -h, --help        Show help

Mounts:
  - ESP -> /mnt/efi (UKIs live in efi/EFI/Linux)
  - cryptroot -> /mnt (with subvolumes @, @home, @snapshots, @log, @nix)
  - crypthome -> /mnt/home (if exists, subvolume @home)
  - cryptdata -> /mnt/var/lib (if exists, subvolumes docker, containers, etc.)
  - cryptswap -> swapon (if exists)
  - swap -> swapon (plain, unencrypted swap partition; if exists)
EOF
}

# ─── Parse args ──────────────────────────────────────────────────────
parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      --mnt) MNT="$2"; shift 2 ;;
      --umount) UMOUNT="yes"; shift ;;
      --no-open) OPEN_LUKS="no"; shift ;;
      --close-on-exit) CLOSE_ON_EXIT="yes"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) err "Unknown option: $1"; usage; exit 1 ;;
      *) DISK="$1"; shift ;;
    esac
  done
}

# ─── Find partitions ─────────────────────────────────────────────────
find_parts() {
  ESP=$(lsblk -rno PATH,PARTLABEL "$DISK" 2>/dev/null | awk '$2=="ESP" {print $1}')
  CRYPTROOT=$(lsblk -rno PATH,PARTLABEL "$DISK" 2>/dev/null | awk '$2=="cryptroot" {print $1}')
  CRYPTHOME=$(lsblk -rno PATH,PARTLABEL "$DISK" 2>/dev/null | awk '$2=="crypthome" {print $1}')
  CRYPTDATA=$(lsblk -rno PATH,PARTLABEL "$DISK" 2>/dev/null | awk '$2=="cryptdata" {print $1}')
  CRYPTSWAP=$(lsblk -rno PATH,PARTLABEL "$DISK" 2>/dev/null | awk '$2=="cryptswap" {print $1}')
  SWAPDEV=$(lsblk -rno PATH,PARTLABEL "$DISK" 2>/dev/null | awk '$2=="swap" {print $1}')
}

# ─── Helpers ─────────────────────────────────────────────────────────
open_luks() {
  local part="$1" name="$2"
  if ! [[ -b "/dev/mapper/$name" ]]; then
    info "Opening $name..."
    cryptsetup open "$part" "$name"
  else
    info "$name already open."
  fi
}

mount_subvol() {
  local device="$1" subvol="$2" target="$3" opts="${4:-defaults,noatime,compress=zstd}"
  mkdir -p "$target"
  mount -o "$opts,subvol=$subvol" "$device" "$target"
  ok "Mounted $subvol ($device) -> $target"
}

# ─── Main ────────────────────────────────────────────────────────────
main() {
  parse_args "$@"
  [[ $EUID -ne 0 ]] && { err "Run as root (sudo)."; exit 1; }

  # Umount mode: unmount + close LUKS, no mounting
  if [[ "$UMOUNT" == "yes" ]]; then
    unmount_close
    ok "Done."
    exit 0
  fi

  # Auto-detect: the disk carrying a cryptroot partition
  if [[ -z "$DISK" ]]; then
    for d in $(lsblk -dno PATH -e 7,11); do
      if lsblk -rno PATH,PARTLABEL "$d" 2>/dev/null | awk '$2=="cryptroot"' | grep -q .; then
        DISK="$d"
        info "Auto-detected disk: $DISK"
        break
      fi
    done
  fi
  [[ -z "$DISK" ]] && { err "Disk required (auto-detect found none)."; usage; exit 1; }

  find_parts
  [[ -z "$ESP" || -z "$CRYPTROOT" ]] && { err "Required partitions not found on $DISK"; exit 1; }

  # Root device: LUKS mapper when encrypted, partition directly when not
  ROOTDEV="/dev/mapper/cryptroot"
  if cryptsetup isLuks "$CRYPTROOT" 2>/dev/null; then
    [[ "$OPEN_LUKS" == "yes" ]] && open_luks "$CRYPTROOT" "cryptroot"
  else
    ROOTDEV="$CRYPTROOT"
    info "cryptroot is not LUKS-encrypted; mounting directly."
  fi

  if [[ "$OPEN_LUKS" == "yes" ]]; then
    [[ -n "$CRYPTHOME" ]] && open_luks "$CRYPTHOME" "crypthome"
    [[ -n "$CRYPTDATA" ]] && open_luks "$CRYPTDATA" "cryptdata"
    [[ -n "$CRYPTSWAP" ]] && open_luks "$CRYPTSWAP" "cryptswap"
  fi

  mkdir -p "$MNT"
  info "Mounting root subvolumes..."
  mount_subvol "$ROOTDEV" @ "$MNT"
  # separate encrypted home overrides root's @home — don't stack mounts
  # (duplicates confuse nixos-generate-config)
  if [[ -z "$CRYPTHOME" ]]; then
    mount_subvol "$ROOTDEV" @home "$MNT/home"
  fi
  mount_subvol "$ROOTDEV" @snapshots "$MNT/.snapshots"
  mount_subvol "$ROOTDEV" @log "$MNT/var/log"
  mount_subvol "$ROOTDEV" @nix "$MNT/nix"

  # Boot (ESP at /efi — UKI layout, matches the hosts' mountpoints)
  mkdir -p "$MNT/efi"
  mount "$ESP" "$MNT/efi"
  ok "Mounted ESP -> $MNT/efi"
  # nixos-install expects an EFI dir on the ESP (case-sensitive vfat)
  mkdir -p "$MNT/efi/EFI"

  if [[ -n "$CRYPTHOME" ]]; then
    mount_subvol /dev/mapper/crypthome @home "$MNT/home"
  fi

  if [[ -n "$CRYPTDATA" ]]; then
    mount_subvol /dev/mapper/cryptdata docker "$MNT/var/lib/docker"
    mount_subvol /dev/mapper/cryptdata containers "$MNT/var/lib/containers"
    mount_subvol /dev/mapper/cryptdata syncthing "$MNT/var/syncthing"
    mount_subvol /dev/mapper/cryptdata backups "$MNT/var/backups"
    mount_subvol /dev/mapper/cryptdata libvirt "$MNT/var/lib/libvirt"
  fi

  # encrypted + plain; tolerate already-active swap (nonzero exit)
  if [[ -n "$CRYPTSWAP" ]]; then
    if grep -qs "cryptswap" /proc/swaps; then
      ok "Swap already on /dev/mapper/cryptswap"
    else
      swapon /dev/mapper/cryptswap
      ok "Swap on /dev/mapper/cryptswap"
    fi
  fi
  if [[ -n "$SWAPDEV" ]]; then
    if grep -qs "$SWAPDEV" /proc/swaps; then
      ok "Swap already on $SWAPDEV"
    else
      swapon "$SWAPDEV"
      ok "Swap on $SWAPDEV"
    fi
  fi

  ok "All mounted at $MNT"
  echo
  lsblk -f "$DISK"
  echo
  findmnt -R "$MNT"
}

# ─── Umount + close LUKS ─────────────────────────────────────────────
unmount_close() {
  info "Unmounting $MNT..."
  umount -R "$MNT" 2>/dev/null && ok "Unmounted." || info "Already unmounted or busy."

  info "Closing swap..."
  swapoff /dev/mapper/cryptswap 2>/dev/null || true
  [[ -n "$SWAPDEV" ]] && swapoff "$SWAPDEV" 2>/dev/null || true

  info "Closing LUKS..."
  for name in cryptroot crypthome cryptdata cryptswap; do
    cryptsetup close "$name" 2>/dev/null && ok "Closed $name" || true
  done
}

# ─── Cleanup on exit ─────────────────────────────────────────────────
cleanup() {
  if [[ "$CLOSE_ON_EXIT" == "yes" ]]; then
    unmount_close
    ok "Closed."
  fi
}
trap cleanup EXIT

main "$@"
