#!/usr/bin/env bash
# nixos-prep-disk — format existing partitions for NixOS (LUKS2 + Btrfs)
# Run as root on target machine. Finds partitions by label, reformats in place.

set -euo pipefail

# ─── Pretty ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GRN='\033[0;32m'; YEL='\033[1;33m'; BLU='\033[0;34m'; NC='\033[0m'
info() { echo -e "${BLU}[info]${NC} $*"; }
ok()   { echo -e "${GRN}[ok]${NC}  $*"; }
warn() { echo -e "${YEL}[warn]${NC} $*"; }
err()  { echo -e "${RED}[err]${NC}  $*"; }

# ─── Helpers ─────────────────────────────────────────────────────────
find_part() {
  local disk="$1" label="$2"
  lsblk -rno PATH,LABEL "$disk" | awk -v L="$label" '$2==L {print $1; exit}'
}

confirm() {
  local prompt="$1"
  read -rp "$(echo -e "${YEL}$prompt${NC} ")" ans
  [[ "$ans" == "YES" ]]
}

# ─── Main ────────────────────────────────────────────────────────────
main() {
  if [[ $EUID -ne 0 ]]; then err "Run as root (sudo)."; exit 1; fi

  echo -e "${BLU}=== NixOS Disk Prep ===${NC}"

  # 1. Pick disk
  info "Available disks:"
  lsblk -d -o NAME,SIZE,MODEL,TRAN,TYPE | grep -v loop
  echo
  read -rp "$(echo -e "${BLU}Target disk (e.g. /dev/nvme0n1):${NC} ")" DISK
  [[ -b "$DISK" ]] || { err "Not a block device: $DISK"; exit 1; }

  # 2. Detect existing labels
  ESP_PART=$(find_part "$DISK" "ESP")
  CRYPTROOT_PART=$(find_part "$DISK" "cryptroot")
  CRYPTDATA_PART=$(find_part "$DISK" "cryptdata")

  if [[ -z "$ESP_PART" || -z "$CRYPTROOT_PART" ]]; then
    err "Required partitions not found on $DISK (need ESP + cryptroot labels)."
    lsblk -f "$DISK"
    exit 1
  fi

  # 3. Choose profile
  echo
  info "Detected partitions:"
  echo "  ESP        -> $ESP_PART"
  echo "  cryptroot  -> $CRYPTROOT_PART"
  [[ -n "$CRYPTDATA_PART" ]] && echo "  cryptdata  -> $CRYPTDATA_PART"
  echo

  PS3="$(echo -e "${BLU}Select profile:${NC} ")"
  options=("desktop" "laptop" "server" "Quit")
  select PROFILE in "${options[@]}"; do
    case $PROFILE in
      desktop|laptop|server) break ;;
      Quit) exit 0 ;;
      *) err "Invalid option." ;;
    esac
  done

  # 4. Confirm
  echo
  warn "This will DESTROY all data on:"
  warn "  $ESP_PART (ESP)"
  warn "  $CRYPTROOT_PART (cryptroot)"
  [[ "$PROFILE" == "server" && -n "$CRYPTDATA_PART" ]] && warn "  $CRYPTDATA_PART (cryptdata)"
  echo
  confirm "Type 'YES' to proceed:" || { info "Aborted."; exit 0; }

  # 5. Format
  info "Formatting ESP..."
  mkfs.vfat -F32 -n ESP "$ESP_PART"
  ok "ESP done."

  info "Formatting cryptroot (LUKS2 + Btrfs)..."
  cryptsetup luksFormat --type luks2 --label cryptroot "$CRYPTROOT_PART"
  cryptsetup open "$CRYPTROOT_PART" cryptroot
  mkfs.btrfs -L nixos /dev/mapper/cryptroot
  mount /dev/mapper/cryptroot /mnt
  for sv in @ @home @snapshots @log @nix; do
    btrfs subvolume create "/mnt/$sv"
  done
  umount /mnt
  cryptsetup close cryptroot
  ok "cryptroot done."

  if [[ "$PROFILE" == "server" && -n "$CRYPTDATA_PART" ]]; then
    info "Formatting cryptdata (LUKS2 + Btrfs)..."
    cryptsetup luksFormat --type luks2 --label cryptdata "$CRYPTDATA_PART"
    cryptsetup open "$CRYPTDATA_PART" cryptdata
    mkfs.btrfs -L data /dev/mapper/cryptdata
    mount /dev/mapper/cryptdata /mnt
    for sv in docker containers syncthing backups libvirt; do
      btrfs subvolume create "/mnt/$sv"
    done
    umount /mnt
    cryptsetup close cryptdata
    ok "cryptdata done."
  fi

  # 6. Summary
  echo
  ok "All done. Layout on $DISK:"
  lsblk -f "$DISK"
  echo
  info "Next steps:"
  echo "  - Boot installer ISO, or"
  echo "  - Run: nixos-generate-config --root /mnt (after mounting subvolumes)"
  echo "  - Or let nixos-anywhere generate hardware config:"
  echo "      nixos-anywhere --generate-hardware-config nixos-facter ./hosts/$PROFILE/facter.json --flake .#$PROFILE --target-host root@<ip>"
}

main "$@"