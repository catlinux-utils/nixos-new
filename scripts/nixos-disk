#!/usr/bin/env bash
# nixos-disk — flexible disk preparation for NixOS
# Options-driven: choose encryption, filesystem, layout per partition.
# Run as root on target machine.

set -euo pipefail

# ─── Config ──────────────────────────────────────────────────────────
DISK=""
MNT="/mnt"
ENCRYPT_ROOT="yes"
ENCRYPT_HOME="no"
ENCRYPT_SWAP="yes"
FS_ROOT="btrfs"
FS_HOME="btrfs"
FS_BOOT="vfat"
LAYOUT="auto"          # auto | manual | server
HOSTNAME="nixos"
USE_SWAP="yes"
SWAP_SIZE="8G"
BOOT_SIZE="1G"
ROOT_SIZE=""           # empty = rest of disk
HOME_SIZE=""           # empty = separate partition if ENCRYPT_HOME=yes

# ─── Pretty ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GRN='\033[0;32m'; YEL='\033[1;33m'; BLU='\033[0;34m'; NC='\033[0m'
info() { echo -e "${BLU}[info]${NC} $*"; }
ok()   { echo -e "${GRN}[ok]${NC}  $*"; }
warn() { echo -e "${YEL}[warn]${NC} $*"; }
err()  { echo -e "${RED}[err]${NC}  $*"; }

# ─── Usage ───────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: nixos-disk [options] <disk>

Options:
  --encrypt-root yes|no     Encrypt root partition (default: yes)
  --encrypt-home yes|no     Separate encrypted /home (default: no)
  --encrypt-swap yes|no     Encrypt swap (default: yes)
  --fs-root btrfs|ext4|xfs  Root filesystem (default: btrfs)
  --fs-home btrfs|ext4|xfs  Home filesystem (default: btrfs)
  --fs-boot vfat|ext4       Boot filesystem (default: vfat)
  --layout auto|manual|srv  Layout profile (default: auto)
  --swap yes|no             Create a swap partition (default: yes)
  --swap-size SIZE          Swap size (default: 8G)
  --boot-size SIZE          Boot partition size (default: 1G)
  --root-size SIZE          Root partition size (default: rest)
  --home-size SIZE          Home partition size (default: rest)
  --hostname NAME           Hostname for generated config (default: nixos)
  --mnt PATH                Mountpoint for subvolume creation (default: /mnt)
  -h, --help                Show this help

Examples:
  nixos-disk --encrypt-home yes --fs-root btrfs /dev/nvme0n1
  nixos-disk --layout server /dev/nvme0n1
  nixos-disk /dev/sda  # interactive
EOF
}

# ─── Parse args ──────────────────────────────────────────────────────
parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      --encrypt-root) ENCRYPT_ROOT="$2"; shift 2 ;;
      --encrypt-home) ENCRYPT_HOME="$2"; shift 2 ;;
      --encrypt-swap) ENCRYPT_SWAP="$2"; shift 2 ;;
      --fs-root) FS_ROOT="$2"; shift 2 ;;
      --fs-home) FS_HOME="$2"; shift 2 ;;
      --fs-boot) FS_BOOT="$2"; shift 2 ;;
      --layout) LAYOUT="$2"; shift 2 ;;
      --swap) USE_SWAP="$2"; shift 2 ;;
      --swap-size) SWAP_SIZE="$2"; shift 2 ;;
      --boot-size) BOOT_SIZE="$2"; shift 2 ;;
      --root-size) ROOT_SIZE="$2"; shift 2 ;;
      --home-size) HOME_SIZE="$2"; shift 2 ;;
      --hostname) HOSTNAME="$2"; shift 2 ;;
      --mnt) MNT="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) err "Unknown option: $1"; usage; exit 1 ;;
      *) DISK="$1"; shift ;;
    esac
  done
}

# ─── Interactive prompts ─────────────────────────────────────────────
prompt_fs() {
  local -n ref="$1"
  local label="$2" pattern="$3" ans
  while true; do
    read -rp "$(echo -e "${BLU}${label} [${ref}]:${NC} ")" ans
    ref="${ans:-$ref}"
    [[ "$ref" =~ $pattern ]] && break
    err "Invalid: $ref"
  done
}

prompt_config() {
  # prompts read stdin; a closed/piped stdin would abort or spin the selects
  [[ -t 0 ]] || { err "Interactive config needs a terminal (pass options + disk non-interactively)."; exit 1; }
  echo -e "${BLU}=== NixOS Disk Configuration ===${NC}"
  echo

  info "Available disks:"
  lsblk -d -o NAME,SIZE,MODEL,TRAN,TYPE | grep -v loop
  echo
  read -rp "$(echo -e "${BLU}Target disk (e.g. /dev/nvme0n1):${NC} ")" DISK
  [[ -b "$DISK" ]] || { err "Not a block device: $DISK"; exit 1; }

  echo
  PS3="$(echo -e "${BLU}Layout preset:${NC} ")"
  options=("auto (root+home on single encrypt)" "manual (choose each)" "server (root + data)" "Quit")
  select LAYOUT in "${options[@]}"; do
    case $REPLY in
      1) LAYOUT="auto"; break ;;
      2) LAYOUT="manual"; break ;;
      3) LAYOUT="server"; break ;;
      4) exit 0 ;;
      *) err "Invalid option." ;;
    esac
  done

  echo
  read -rp "$(echo -e "${BLU}Encrypt root? [Y/n]:${NC} ")" ans
  ENCRYPT_ROOT="${ans:-y}"
  [[ "$LAYOUT" != "server" ]] && {
    read -rp "$(echo -e "${BLU}Separate encrypted /home? [y/N]:${NC} ")" ans
    ENCRYPT_HOME="${ans:-n}"
  }

  if [[ "$LAYOUT" != "server" ]]; then
    local swap_def="Y/n"; [[ "$USE_SWAP" =~ ^[Yy] ]] || swap_def="y/N"
    read -rp "$(echo -e "${BLU}Create swap partition? [${swap_def}]:${NC} ")" ans
    USE_SWAP="${ans:-$USE_SWAP}"
    if [[ "$USE_SWAP" =~ ^[Yy] ]]; then
      read -rp "$(echo -e "${BLU}Encrypt swap? [Y/n]:${NC} ")" ans
      ENCRYPT_SWAP="${ans:-$ENCRYPT_SWAP}"
    fi
  fi

  echo
  prompt_fs FS_ROOT "Root filesystem" '^(btrfs|ext4|xfs)$'
  [[ "$ENCRYPT_HOME" =~ ^[Yy] ]] && prompt_fs FS_HOME "Home filesystem" '^(btrfs|ext4|xfs)$'
  prompt_fs FS_BOOT "Boot filesystem" '^(vfat|ext4)$'

  echo
  read -rp "$(echo -e "${BLU}Boot size [${BOOT_SIZE}]:${NC} ")" ans; BOOT_SIZE="${ans:-$BOOT_SIZE}"
  [[ "$USE_SWAP" =~ ^[Yy] ]] && { read -rp "$(echo -e "${BLU}Swap size [${SWAP_SIZE}]:${NC} ")" ans; SWAP_SIZE="${ans:-$SWAP_SIZE}"; }
  [[ -z "$ROOT_SIZE" ]] && read -rp "$(echo -e "${BLU}Root size (empty=rest) [${ROOT_SIZE}]:${NC} ")" ans && ROOT_SIZE="${ans}"
  [[ "$ENCRYPT_HOME" =~ ^[Yy] && -z "$HOME_SIZE" ]] && read -rp "$(echo -e "${BLU}Home size (empty=rest) [${HOME_SIZE}]:${NC} ")" ans && HOME_SIZE="${ans}"

  read -rp "$(echo -e "${BLU}Hostname [${HOSTNAME}]:${NC} ")" ans; HOSTNAME="${ans:-$HOSTNAME}"
}

# ─── Partition helpers ───────────────────────────────────────────────
create_partitions() {
  info "Wiping and creating GPT on $DISK..."
  sgdisk --zap-all "$DISK"
  sgdisk -n 1:0:+$BOOT_SIZE -t 1:EF00 -c 1:"ESP" "$DISK"
  local part=2

  # swap first: the branches below end in fill-rest partitions (-n :0:0).
  # unencrypted swap gets a real partition too (type 8200)
  if [[ "$LAYOUT" != "server" && "$USE_SWAP" =~ ^[Yy] ]]; then
    if [[ "$ENCRYPT_SWAP" =~ ^[Yy] ]]; then
      sgdisk -n $part:0:+$SWAP_SIZE -t $part:8309 -c $part:"cryptswap" "$DISK"
    else
      sgdisk -n $part:0:+$SWAP_SIZE -t $part:8200 -c $part:"swap" "$DISK"
    fi
    ((part++))
  fi

  if [[ "$LAYOUT" == "server" ]]; then
    sgdisk -n $part:0:+${ROOT_SIZE:-100G} -t $part:8309 -c $part:"cryptroot" "$DISK"
    ((part++))
    sgdisk -n $part:0:0 -t $part:8309 -c $part:"cryptdata" "$DISK"
  elif [[ "$ENCRYPT_HOME" =~ ^[Yy] ]]; then
    sgdisk -n $part:0:+${ROOT_SIZE:-50G} -t $part:8309 -c $part:"cryptroot" "$DISK"
    ((part++))
    # last: HOME_SIZE empty = rest of disk
    sgdisk -n $part:0:+${HOME_SIZE:-0} -t $part:8309 -c $part:"crypthome" "$DISK"
  else
    sgdisk -n $part:0:0 -t $part:8309 -c $part:"cryptroot" "$DISK"
  fi
}

format_partition() {
  local part="$1" label="$2" fs="$3" crypt="$4"
  [[ -b "$part" ]] || { err "Partition not found: $label ($part)"; return 1; }

  if [[ "$crypt" =~ ^[Yy] ]]; then
    info "Formatting $label (LUKS2 + $fs)..."
    cryptsetup luksFormat --type luks2 --label "$label" "$part"
    cryptsetup open "$part" "$label"
    local mapper="/dev/mapper/$label"
    case $fs in
      btrfs) mkfs.btrfs -L "$label" "$mapper" ;;
      ext4) mkfs.ext4 -L "$label" "$mapper" ;;
      xfs) mkfs.xfs -L "$label" "$mapper" ;;
    esac
  else
    info "Formatting $label ($fs)..."
    case $fs in
      vfat) mkfs.vfat -F32 -n "$label" "$part" ;;
      ext4) mkfs.ext4 -L "$label" "$part" ;;
      xfs) mkfs.xfs -L "$label" "$part" ;;
    esac
  fi
}

create_subvolumes() {
  local mountpoint="$1" label="$2" fs="$3" device="$4"
  if [[ "$fs" == "btrfs" ]]; then
    mkdir -p "$mountpoint"
    # don't stack mounts on a re-run (a set -e abort leaves open LUKS)
    mountpoint -q "$mountpoint" && { err "$mountpoint already mounted — run nixos-mount --umount first"; return 1; }
    mount "$device" "$mountpoint"
    case $label in
      cryptroot) for sv in @ @home @snapshots @log @nix; do btrfs subvolume create "$mountpoint/$sv"; done ;;
      crypthome) btrfs subvolume create "$mountpoint/@home" ;;
      cryptdata) for sv in docker containers syncthing backups libvirt; do btrfs subvolume create "$mountpoint/$sv"; done ;;
    esac
    umount "$mountpoint"
  fi
}

# ─── Main ────────────────────────────────────────────────────────────
main() {
  parse_args "$@"
  [[ $EUID -ne 0 ]] && { err "Run as root (sudo)."; exit 1; }
  [[ -z "$DISK" ]] && prompt_config

  echo
  warn "Plan for $DISK:"
  echo "  Layout:       $LAYOUT"
  echo "  Encrypt root: $ENCRYPT_ROOT"
  echo "  Encrypt home: $ENCRYPT_HOME"
  echo "  Encrypt swap: $ENCRYPT_SWAP"
  echo "  FS root:      $FS_ROOT"
  echo "  FS home:      $FS_HOME"
  echo "  FS boot:      $FS_BOOT"
  echo "  Boot size:    $BOOT_SIZE"
  if [[ "$LAYOUT" == "server" ]]; then
    echo "  Swap:         no (server layout)"
  else
    echo "  Swap:         $USE_SWAP"
    [[ "$USE_SWAP" =~ ^[Yy] ]] && echo "  Swap size:    $SWAP_SIZE"
  fi
  echo "  Root size:    ${ROOT_SIZE:-rest}"
  echo "  Home size:    ${HOME_SIZE:-rest}"
  echo "  Hostname:     $HOSTNAME"
  echo
  read -rp "$(echo -e "${YEL}Proceed? Type 'YES':${NC} ")" ans
  [[ "$ans" == "YES" ]] || { info "Aborted."; exit 0; }

  create_partitions
  sleep 1
  partprobe "$DISK"
  sleep 1

  # lookup by GPT PARTLABEL (exists right after sgdisk, fs LABEL doesn't)
  ESP=$(lsblk -rno PATH,PARTLABEL "$DISK" | awk '$2=="ESP" {print $1}')
  CRYPTROOT=$(lsblk -rno PATH,PARTLABEL "$DISK" | awk '$2=="cryptroot" {print $1}')
  CRYPTHOME=$(lsblk -rno PATH,PARTLABEL "$DISK" | awk '$2=="crypthome" {print $1}')
  CRYPTDATA=$(lsblk -rno PATH,PARTLABEL "$DISK" | awk '$2=="cryptdata" {print $1}')
  CRYPTSWAP=$(lsblk -rno PATH,PARTLABEL "$DISK" | awk '$2=="cryptswap" {print $1}')
  SWAPDEV=$(lsblk -rno PATH,PARTLABEL "$DISK" | awk '$2=="swap" {print $1}')

  local root_dev
  [[ "$ENCRYPT_ROOT" =~ ^[Yy] ]] && root_dev="/dev/mapper/cryptroot" || root_dev="$CRYPTROOT"
  format_partition "$ESP" "ESP" "$FS_BOOT" "no"
  format_partition "$CRYPTROOT" "cryptroot" "$FS_ROOT" "$ENCRYPT_ROOT"
  create_subvolumes "$MNT" "cryptroot" "$FS_ROOT" "$root_dev"

  [[ "$ENCRYPT_HOME" =~ ^[Yy] && -n "$CRYPTHOME" ]] && {
    format_partition "$CRYPTHOME" "crypthome" "$FS_HOME" "yes"
    create_subvolumes "$MNT/home" "crypthome" "$FS_HOME" "/dev/mapper/crypthome"
  }

  [[ "$LAYOUT" == "server" && -n "$CRYPTDATA" ]] && {
    format_partition "$CRYPTDATA" "cryptdata" "btrfs" "yes"
    create_subvolumes "$MNT/var/lib" "cryptdata" "btrfs" "/dev/mapper/cryptdata"
  }

  [[ "$LAYOUT" != "server" && "$USE_SWAP" =~ ^[Yy] && "$ENCRYPT_SWAP" =~ ^[Yy] && -n "$CRYPTSWAP" ]] && {
    format_partition "$CRYPTSWAP" "cryptswap" "swap" "yes"
    mkswap /dev/mapper/cryptswap
  }

  [[ "$LAYOUT" != "server" && "$USE_SWAP" =~ ^[Yy] && ! "$ENCRYPT_SWAP" =~ ^[Yy] && -n "$SWAPDEV" ]] && {
    info "Formatting swap..."
    mkswap "$SWAPDEV"
  }

  cryptsetup close cryptroot 2>/dev/null || true
  [[ -n "$CRYPTHOME" ]] && cryptsetup close crypthome 2>/dev/null || true
  [[ -n "$CRYPTDATA" ]] && cryptsetup close cryptdata 2>/dev/null || true
  [[ -n "$CRYPTSWAP" ]] && cryptsetup close cryptswap 2>/dev/null || true

  ok "Disk prepared. Layout:"
  lsblk -f "$DISK"
  echo
  info "Next: run 'nixos-mount' to mount everything, then nixos-install"
}

main "$@"
