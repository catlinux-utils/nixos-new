# generated by matugen from the running wallpaper — sourced by the catlinux
# zsh theme at shell start (the theme keeps hardcoded fallbacks for machines
# without this file). Values follow the scheme-fidelity palette picked in
# modules/home/theming/palette.nix.
CATLINUX_PWD_FG={{colors.primary.default.hex}}
CATLINUX_GIT_CLEAN={{colors.tertiary.default.hex}}
CATLINUX_GIT_INDEXED={{colors.primary.default.hex}}
CATLINUX_GIT_DIRTY={{colors.error.default.hex}}
